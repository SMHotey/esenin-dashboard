{
  "project": "esenin-dashboard",
  "board": "esenin-dashboard",
  "ui_port": 8771,
  "profiles": {
    "driver": "writer",
    "prompter": "prompter",
    "reviewer": "reviewer"
  },
  "skills": {
    "step": [
      "pipeline-next-step"
    ],
    "review": [
      "pipeline-reviewer"
    ],
    "prompt": [
      "pipeline-prompter",
      "agent-prompt-authoring"
    ]
  },
  "paths": {
    "plans": "docs/plans",
    "reviews": "docs/reviews",
    "prompts": "docs/prompts",
    "state": ".pipeline/state"
  },
  "markers": {
    "journal": "журнал",
    "steps": "шаг"
  },
  "step_id_regex": "(?P<id>[A-Za-z]{1,4}\\d+[A-Za-z]?(?:-\\d+)?)",
  "default_plan": null,
  "driven_plans": [
    "*"
  ],
  "require_prompt": true,
  "max_actions": 1,
  "max_fix_rounds": 3,
  "runtimes": {
    "step": "270m",
    "review": "225m",
    "prompt": "68m"
  },
  "kanban": {
    "tenant": "plan"
  },
  "git": {
    "commit": true,
    "push": true
  },
  "notify": {
    "enabled": true,
    "token_env": "STEP_PIPELINE_TELEGRAM_BOT_TOKEN",
    "chat_env": "STEP_PIPELINE_TELEGRAM_CHAT_ID",
    "prefix": "Есенин: ",
    "watchdog_hours": 3,
    "digest_at": "09:00",
    "owner_env": "STEP_PIPELINE_TELEGRAM_OWNER_ID",
    "dialog": {
      "enabled": true
    }
  }
}
